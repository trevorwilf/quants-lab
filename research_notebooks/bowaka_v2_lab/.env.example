# Bowaka v2 Lab environment example. Copy to .env and fill in values.
# All variables can also be set in the repo-root .env (auto-discovered).

# Required everywhere
MONGO_URI=mongodb://admin:admin@localhost:27017/quants_lab?authSource=admin
MONGO_DATABASE=quants_lab

# Required Phase 3+ (porting from v2 archive)
BOWAKA_V2_SOURCE_ROOT=

# Required for Phase 7 reconciliation against real paper logs
BOWAKA_V2_PAPER_LOGS_ROOT=

# Optional; if unset, live_alpaca-marked tests are deselected
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
BOWAKA_V2_ALPACA_FEED=iex
