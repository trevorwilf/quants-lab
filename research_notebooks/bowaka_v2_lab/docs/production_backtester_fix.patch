+def _resolve_backtest_lake_root(args, cfg) -> Path:
+    """Resolve the lake root in the same order ``bowaka_common`` does.
+
+      1. ``--lake-root <path>`` CLI override (if present).
+      2. ``cfg.market_data.shared_root`` (if the config has it).
+      3. ``$MARKET_DATA_ROOT`` env var.
+      4. In-repo default: ``<repo>/research_notebooks/market_data``.
+
+    The in-repo default is what the lab uses by default; matching it
+    lets the production backtester read the same data the lab does
+    without further configuration.
+    """
+    if getattr(args, "lake_root", None):
+        return Path(args.lake_root).resolve()
+    md = cfg.get("market_data") or {}
+    if md.get("shared_root"):
+        return Path(md["shared_root"]).resolve()
+    try:
+        # bowaka_common is on PYTHONPATH when this script runs inside the lab
+        # repo. In the LIVE production repo, bowaka_common must also be
+        # importable for the lake path to work; see the operator-facing note
+        # at the top of this script.
+        from bowaka_common.marketdata.store import resolve_market_data_root
+        return resolve_market_data_root(None, create=False)
+    except ImportError:
+        env = os.environ.get("MARKET_DATA_ROOT")
+        if env:
+            return Path(env).resolve()
+        raise RuntimeError(
+            "could not resolve market data lake root. install "
+            "bowaka_common or pass --lake-root <path>."
+        )
+
+
+def _resolve_required_adjustment(cfg) -> str:
+    """Return ``split_adjusted`` if the config requires it; else ``raw``.
+
+    Mirrors the lab's ``daily_adjustment_for_config`` resolver so the
+    production backtester reads the same adjustment partition the live
+    scanner does.
+    """
+    md = cfg.get("market_data") or {}
+    if md.get("require_split_adjustment") or md.get("require_adjusted_daily_bars"):
+        return "split_adjusted"
+    return "raw"
+
+
+def _make_lake_suppliers(*, lake_root: Path, feed: str, adjustment: str):
+    """Build the two callables ``run_backtest`` expects.
+
+    Both go through ``MarketDataStore`` so we read whatever
+    (vendor, feed, adjustment) is on disk — same path the live scanner uses.
+    """
+    from bowaka_common.marketdata.store import MarketDataStore
+    store = MarketDataStore(lake_root, vendor="alpaca")
+
+    def minute_bars(symbol: str, session_date: str) -> pd.DataFrame:
+        start = pd.Timestamp(session_date + " 09:30",
+                             tz="America/New_York").tz_convert("UTC")
+        end = pd.Timestamp(session_date + " 16:00",
+                           tz="America/New_York").tz_convert("UTC")
+        df = store.minute_bars(symbol, start, end, feed=feed)
+        # run_backtest expects ``timestamp`` to be the column name, tz-aware
+        # UTC. MarketDataStore returns that already; if the schema drifts, the
+        # integration test catches it.
+        return df
+
+    def daily_bars(symbol: str, session_date: str) -> pd.DataFrame:
+        # The strategy needs prior daily bars to compute baselines
+        # (avg_dollar_volume_20d, prior_atr_pct, ema_slope_prior). Request 30
+        # calendar days back from session_date to cover the 20-day window plus
+        # weekends/holidays.
+        end = pd.Timestamp(session_date).tz_localize("UTC") - pd.Timedelta(days=1)
+        start = end - pd.Timedelta(days=30)
+        return store.daily_bars(
+            symbol, start, end, feed=feed, adjustment=adjustment,
+        )
+
+    return minute_bars, daily_bars
+
+
