# Alpaca market data credentials. Paper-trading keys are acceptable for data reads.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# Data feed. Use iex for free exploratory research. Use sip only when authorized.
BOWAKA_ALPACA_FEED=iex

# MongoDB. Can point to root QuantLab MongoDB.
MONGO_URI=mongodb://admin:admin@localhost:27017/quants_lab?authSource=admin
MONGO_DATABASE=quants_lab

# Storage root. If unset, bowaka_lab should auto-detect root QuantLab and use app/data/bowaka_lab.
BOWAKA_DATA_ROOT=
BOWAKA_OUTPUT_ROOT=

# Safety toggles.
BOWAKA_ALLOW_LIVE_ALPACA=false
BOWAKA_DEFAULT_ADJUSTMENT=raw

# Optional: legacy Bowaka strategy source root for prefilter parity test.
# If unset, parity test is skipped.
BOWAKA_SOURCE_STRATEGY_ROOT=

# Optional: legacy Bowaka paper-trading logs root for live reconciliation test.
# If unset, live reconciliation test is skipped.
BOWAKA_PAPER_LOGS_ROOT=
