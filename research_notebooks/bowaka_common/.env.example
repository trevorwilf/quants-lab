# bowaka_common environment (all optional)
#
# MARKET_DATA_ROOT — override the shared market-data lake location.
# When unset it defaults to <repo_root>/research_notebooks/market_data, which
# resolves identically on the host and inside the ql-jupyter container (the repo
# is bind-mounted at /quants-lab). Set this only to relocate the lake elsewhere
# (e.g. a shared drive consumed by other projects).
MARKET_DATA_ROOT=
