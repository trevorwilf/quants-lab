# =============================================================================
# .env.example — Quants Lab Desktop Stack
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Used by: quantslab_desktop_compose.yaml
# =============================================================================

# ── Trading Pod / TrueNAS ──────────────────────────────────────────────────
# LAN IP of the machine running MongoDB (your Trading Pod / TrueNAS)
TRUENAS_LAN_IP=192.168.1.54

# MongoDB root password (must match the Trading Pod's MongoDB config)
MONGO_ROOT_PASSWORD=your-mongo-root-password-here

# Full MongoDB URI (auto-constructed in compose from the above, but you can
# override it here for local development outside Docker)
# MONGO_URI=mongodb://admin:YOUR_PASSWORD@192.168.1.54:27017/quants_lab?authSource=admin&retryWrites=true&w=majority

# ── JupyterLab ─────────────────────────────────────────────────────────────
# Access token for JupyterLab (change this to something secure)
JUPYTER_TOKEN=change-me

# ── Shared market-data lake ────────────────────────────────────────────────
# MARKET_DATA_ROOT — override the shared Alpaca market-data lake location.
# Optional: when unset it defaults to research_notebooks/market_data inside the
# repo (already visible in the ql-jupyter container, which mounts the repo at
# /quants-lab). Set it only to relocate the lake onto another drive.
# MARKET_DATA_ROOT=
